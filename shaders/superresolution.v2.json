{
  "schema_version": 2,
  "profiles": {
    "*": {
      "enabled": false,
      "comment": "Fallback: disabled. Each dimension must be explicitly enabled."
    },
    "0": {
      "comment": "主世界 (world0)",
      "jitter": {
        "enabled": true,
        "source": "mod"
      },
      "upscale": {
        "enabled": true,
        "hdr": true,
        "auto_exposure": true,
        "motion_jittered": false,
        "internal_format": "rgba16f",
        "trigger": {
          "type": "AFTER",
          "pass": "composite21"
        },
        "inputs": {
          "color":         { "enabled": true, "src": "colortex0", "region": [0, 0, -1, -1] },
          "depth":         { "enabled": true, "src": "depthtex", "region": [0, 0, -1, -1] },
          "motion_vectors": { "enabled": true, "src": "colortex9", "region": [0, 0, -1, -1] }
        },
        "outputs": {
          "upscaled_color": {
            "enabled": true,
            "target": ["colortex0"],
            "region": [0, 0, -2, -2]
          }
        },
        "customs": {
          "motion_vector_preprocessing_function": "vec2 motionVectorPreprocessing(vec2 mv) { float lenMv = length(mv); if (lenMv > 0.4) { mv *= 0.4 / lenMv; } return mv; }"
        }
      }
    },
    "-1": {
