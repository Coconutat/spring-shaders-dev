{
    "version": 1,

    "excludeLodsFromVanillaDepth": false,

    "blending": {
		-1: "off"
	},

    "uniforms": 
    [
        "cameraPosition",
        "viewSize",
        "invViewSize",

        "vxModelView",
        "vxProj",
        "vxProjInv",
        "vxViewProjInv",

        "gbufferModelView",
        "gbufferModelViewInverse",

        "frameCounter",
        "frameTimeCounter",
        "framemod8",
        "isEyeInWater",

        "voxyTaaAmount",

        "springJitterNDC",
        "springJitterUV"
    ],

    "samplers": {
        "depthtex1":"sampler2D",
        "noisetex":"sampler2D"
    },

    "opaqueDrawBuffers": [0,4,5,9],

    "translucentDrawBuffers": [16,17,18],

    "taaOffset":"
    {
        return springJitterNDC * invViewSize * voxyTaaAmount;
    }
    "
}